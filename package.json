{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "prompt-helper",
  "title": "Prompt Helper",
  "description": "Query and paste prompts from PromptHub directly within Raycast",
  "icon": "command-icon.png",
  "author": "sh0rk",
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "license": "MIT",
  "keywords": [
    "prompt",
    "helper",
    "prompthub",
    "提示词"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Prompt Helper",
      "subtitle": "PromptHub",
      "description": "Search, fill variables, and paste prompts from PromptHub",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "serverUrl",
      "title": "PromptHub Server URL",
      "description": "Base URL of PromptHub instance",
      "type": "textfield",
      "required": false,
      "default": "http://127.0.0.1:3210"
    },
    {
      "name": "apiKey",
      "title": "Personal Access Token (PAT)",
      "description": "Optional PAT for PromptHub remote/cloud instances",
      "type": "password",
      "required": false
    },
    {
      "name": "defaultView",
      "title": "默认展示视图",
      "description": "打开插件时默认呈现的视图：全部提示词 / ⭐ 我的收藏 / 🕒 最近使用",
      "type": "dropdown",
      "required": false,
      "default": "all",
      "data": [
        {
          "title": "全部提示词 (智能分段)",
          "value": "all"
        },
        {
          "title": "⭐ 我的收藏 (Favorites)",
          "value": "favorites"
        },
        {
          "title": "🕒 最近使用 (Recent)",
          "value": "recent"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.4.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.13.0",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "vitest run",
    "prepublishOnly": "echo \"\\n\\nIt's recommended to run \\`npm run build\\` before publishing!\\n\\n\" && exit 0",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS"
  ]
}
